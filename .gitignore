# dependencies
node_modules/

# build output
dist/

# optional local sprite pack (NEVER commit - keep copyrighted sheets local)
public/sprites/

# analysis artefacts derived from the sprite pack (same rule: never commit)
# - tools/*.png are contact sheets / verification crops straight out of the sheets
# - tools/frames.json holds measured bounding boxes of the same frames
# - tools/stage1_layout.json is the raw measurement dump of stage1ImageData.ts
tools/*.png
tools/frames.json
tools/stage1_layout.json

